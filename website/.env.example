# Appointment form delivery (src/app/api/appointment/route.ts).
# Copy to .env.local and fill in. Without all three, the form returns 500 and the
# reason is logged server-side.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where appointment requests land.
APPOINTMENT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend; until the domain
# decision is made (payals.com, see AUDIT_BOARD.md), Resend's own test sender
# onboarding@resend.dev works and can only deliver to your own account address.
APPOINTMENT_FROM_EMAIL=
