<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon for Android 8+. The launcher masks the layers to whatever shape
  the device uses, so the mark sits well inside the safe zone and the ground is
  the brand's white rather than a colour that would fight the mark.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
