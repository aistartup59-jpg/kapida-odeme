NODE_ENV=test
PORT=3001

# Points at the dedicated postgres-test service in docker-compose.yml — never the dev DB.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=kapida
DATABASE_PASSWORD=kapida
DATABASE_NAME=kapida_test

# Required. No default — the application refuses to start without it.
JWT_SECRET=test-jwt-secret-change-me

# Required. No default — the application refuses to start without it.
CREDENTIAL_ENCRYPTION_SECRET=test-credential-encryption-secret-change-me

# Effectively off for the suite: hundreds of merchants register from one address in a couple
# of minutes, which is exactly the pattern the production defaults exist to stop. The limits
# themselves are exercised by test/integration/security/rate-limit.spec.ts, which sets its own
# values before booting an app.
RATE_LIMIT_GLOBAL_PER_MINUTE=1000000
RATE_LIMIT_AUTH_PER_MINUTE=1000000
RATE_LIMIT_SIGNUP_PER_MINUTE=1000000
RATE_LIMIT_PARTNER_PER_MINUTE=1000000
